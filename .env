# -----------------------------------------------------------------------------
# Security Settings (Production Hardening)
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
CSRF_TRUSTED_ORIGINS=https://DAPIAD.up.railway.app

# -----------------------------------------------------------------------------
# CORS (if using separate frontend)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://DAPIAD.up.railway.app
CORS_ALLOW_CREDENTIALS=True

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
DJANGO_LOG_LEVEL=INFO

# Sentry DSN (optional - for error tracking)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# -----------------------------------------------------------------------------
# Third-party Services
# -----------------------------------------------------------------------------
# WhatsApp Business API (if integrating directly)
# WHATSAPP_API_TOKEN=your-whatsapp-api-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# -----------------------------------------------------------------------------
# Celery (for async tasks - notifications, image processing, etc.)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=30 * 60

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_SELLER_VERIFICATION=True
ENABLE_LISTING_IMAGES=True
MAX_IMAGES_PER_LISTING=3
ENABLE_WHATSAPP_CLICK_TRACKING=False

